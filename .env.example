# ---- Required ----
# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox → Create App (type Merchant).
# IMPORTANT: link it to a UNITED STATES sandbox business account (other countries can't take card payments).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# OpenAI (GPT-5.6 Luna) for the AI analysis (milestone 2)
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Passcode for actions that change disputes (reset, submit, refund). Required in production.
DEMO_PASSCODE=
# Signs session cookies. Set it in production, or sessions reset on every restart.
SESSION_SECRET=

# ---- Optional (defaults shown) ----
# PORT=3000
# PAYPAL_BASE=https://api-m.sandbox.paypal.com   # seeding refuses to run against anything but the sandbox
# DB_PATH=data/app.db                            # cache only; rebuilt from PayPal if deleted
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io  # durable mirror (free tier): history survives restarts
# TURSO_AUTH_TOKEN=                               # `turso db tokens create <db>`; keep it secret
# SYNC_INTERVAL_MS=30000
# POOL_PER_SCENARIO=1                            # fresh disputes kept in reserve per demo scenario
# RESET_COOLDOWN_MS=120000
# MAX_SEEDS_PER_HOUR=24                          # hard cap on sandbox sales+chargebacks created per hour
# TEST_CARD_NUMBER=4111111111111111
# NODE_ENV=production                            # also implied by Render's RENDER variable
